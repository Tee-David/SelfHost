# SelfHost safe example configuration
# Copy to .env and replace values locally. Never commit .env.

# Authentication
SESSION_SECRET=replace-with-a-long-random-secret
SELFHOST_ADMIN_USER=admin

# Hestia integration
HESTIA_BIN=/usr/local/hestia/bin
HESTIA_USER=admin
SELFHOST_FILES_ROOT=/home/admin/web
SELFHOST_ZIP_HELPER=/usr/local/lib/selfhost/zip-helper.sh

# Optional OCI integration. Leave disabled unless configured.
OCI_ENABLED=false
OCI_CONFIG_FILE=/home/selfhost/.oci/config
OCI_PROFILE=DEFAULT
OCI_COMPARTMENT_ID=
OCI_INSTANCE_ID=

# Application
NODE_ENV=development
SELFHOST_BASE_URL=http://localhost:3000
